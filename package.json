{
  "name": "ts-retry-circuit",
  "version": "2.1.0",
  "license": "MIT",
  "description": "A production-grade, isomorphic circuit breaker and auto-retry library for Node.js and Next.js",
  "author": "TitleKung-01",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TitleKung-01/ts-retry-circuit.git"
  },
  "bugs": {
    "url": "https://github.com/TitleKung-01/ts-retry-circuit/issues"
  },
  "homepage": "https://github.com/TitleKung-01/ts-retry-circuit#readme",
  "keywords": [
    "circuit-breaker",
    "retry",
    "backoff",
    "jitter",
    "react",
    "typescript",
    "nextjs",
    "isomorphic",
    "resilience"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test:run",
    "prepublishOnly": "npm run validate && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0 || ^20.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "vitest run --related --passWithNoTests"
    ]
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}